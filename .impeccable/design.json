  "components": [
    {
      "name": "Sign Button",
      "kind": "button",
      "refersTo": "button-sign",
      "description": "Yellow sign panel for the primary action.",
      "html": "<button class=\"ds-btn ds-btn-sign\">Check in <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M5 12h13M12 5l7 7-7 7\"/></svg></button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:10px;min-height:48px;padding:0 20px;border-radius:2px;border:2px solid transparent;font-family:Barlow,system-ui,sans-serif;font-size:17px;font-weight:700;cursor:pointer;transition:background-color .18s,border-color .18s,color .18s,transform .15s cubic-bezier(.16,1,.3,1)}.ds-btn svg{width:20px;height:20px}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:3px solid #141413;outline-offset:3px;box-shadow:0 0 0 6px #ffc629}.ds-btn-sign{background:#ffc629;color:#141413}.ds-btn-sign:hover{background:#ffd35c}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Black sign with yellow type by day (yellow with black at night).",
      "html": "<button class=\"ds-btn-primary\">Start a project</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;min-height:48px;padding:0 20px;border-radius:2px;border:2px solid transparent;background:#141413;color:#ffc629;font-family:Barlow,system-ui,sans-serif;font-size:17px;font-weight:700;cursor:pointer;transition:background-color .18s}.ds-btn-primary:hover{background:#34332f}.ds-btn-primary:focus-visible{outline:3px solid #141413;outline-offset:3px;box-shadow:0 0 0 6px #ffc629}"
    },
    {
