      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;min-height:48px;padding:0 20px;border-radius:2px;border:2px solid #141413;background:transparent;color:#141413;font-family:Barlow,system-ui,sans-serif;font-size:17px;font-weight:700;cursor:pointer;transition:background-color .18s,color .18s}.ds-btn-secondary:hover{background:#141413;color:#ebe8e1}.ds-btn-secondary:focus-visible{outline:3px solid #141413;outline-offset:3px;box-shadow:0 0 0 6px #ffc629}"
    },
    {
      "name": "Header Sign",
      "kind": "nav",
      "refersTo": "header-sign",
      "description": "Overhead wayfinding strip; stays yellow at night.",
      "html": "<nav class=\"ds-nav\"><strong>Al-Kahfi</strong><a href=\"#\">Work <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.75\"><path d=\"M5 12h13M12 5l7 7-7 7\"/></svg></a><a href=\"#\">About</a><span class=\"ds-lang\"><button aria-pressed=\"true\">EN</button><button aria-pressed=\"false\">ID</button></span></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:4px;height:64px;padding:0 20px;background:#ffc629;color:#141413;border-bottom:2px solid #141413;font-family:Barlow,system-ui,sans-serif}.ds-nav strong{font-family:'Barlow Semi Condensed',Barlow,sans-serif;font-size:21px;font-weight:800;margin-right:auto}.ds-nav a{display:inline-flex;align-items:center;gap:4px;min-height:44px;padding:0 12px;font-size:17px;font-weight:600;color:inherit;text-decoration:none}.ds-nav a svg{width:16px;height:16px}.ds-nav a:hover{text-decoration:underline;text-decoration-thickness:3px;text-underline-offset:8px}.ds-nav a:focus-visible{outline:3px solid #141413;outline-offset:3px}.ds-lang{display:flex;border:2px solid #141413;border-radius:2px;margin-left:8px}.ds-lang button{min-width:44px;min-height:40px;border:0;background:none;font:700 14px Barlow,sans-serif;letter-spacing:.04em;color:#141413;cursor:pointer}.ds-lang button[aria-pressed=true]{background:#141413;color:#ffc629}.ds-lang button[aria-pressed=false]:hover{background:#ffd35c}"
    },
    {
      "name": "Departure Board Row",
      "kind": "custom",
      "refersTo": "departure-board",
      "description": "Black board with split-flap cells and a hinge line; LIVE in departure green.",
      "html": "<div class=\"ds-board\"><div class=\"ds-row\"><span class=\"ds-flaps\"><i>2</i><i>0</i><i>2</i><i>4</i></span><span class=\"ds-flaps\"><i>P</i><i>I</i><i>S</i></span><span class=\"ds-flaps ds-live\"><i>L</i><i>I</i><i>V</i><i>E</i></span></div></div>",
      "css": ".ds-board{background:#0e0f11;color:#f3f0e7;padding:20px;border-radius:4px;border:1px solid #2b2d31;box-shadow:inset 0 1px 0 rgb(255 255 255/.06),0 4px 8px rgb(20 20 19/.08),0 28px 48px -18px rgb(20 20 19/.35)}.ds-row{display:flex;gap:28px;padding:4px 0;transition:background-color .2s}.ds-row:hover{background:rgb(255 255 255/.05)}.ds-flaps{display:flex;gap:3px}.ds-flaps i{position:relative;display:grid;place-items:center;width:28px;height:42px;border-radius:2px;background:linear-gradient(#25272b 0 50%,#1e2024 50%);font:normal 700 30px/1 'Barlow Semi Condensed',Barlow,sans-serif;overflow:hidden}.ds-flaps i::after{content:'';position:absolute;inset:50% 0 auto;height:1px;background:#050506}.ds-live{color:#3ddc75}"
    },
    {
      "name": "Gate Card",
      "kind": "card",
      "refersTo": "gate-sign-bar",
      "description": "Project as a gate: black sign bar, yellow gate plate, flat 2px-ruled body.",
      "html": "<a class=\"ds-gate\" href=\"#\"><div class=\"ds-gate-bar\"><span class=\"ds-gate-no\">A1</span><span><b>PI Smart</b><small>Internal platform</small></span></div><div class=\"ds-gate-body\"><span class=\"ds-chip\">Live</span></div></a>",
      "css": ".ds-gate{display:flex;flex-direction:column;background:#f8f6f1;color:#141413;border:2px solid #141413;text-decoration:none;font-family:Barlow,system-ui,sans-serif}.ds-gate:focus-visible{outline:3px solid #141413;outline-offset:3px;box-shadow:0 0 0 6px #ffc629}.ds-gate-bar{display:flex;align-items:center;gap:16px;min-height:76px;background:#141413;color:#f3f0e7}.ds-gate-no{align-self:stretch;display:grid;place-items:center;min-width:76px;background:#ffc629;color:#141413;font:800 30px 'Barlow Semi Condensed',Barlow,sans-serif}.ds-gate-bar b{display:block;font-size:26px;line-height:1.05;letter-spacing:-.01em}.ds-gate-bar small{font-size:15px;color:#bdb9af}.ds-gate:hover .ds-gate-bar b{text-decoration:underline}.ds-gate-body{padding:14px 18px 16px}.ds-chip{display:inline-flex;padding:5px 9px;background:#141413;color:#3ddc75;font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}"
    },
    {
      "name": "Boarding Pass Stub",
      "kind": "custom",
      "refersTo": "boarding-pass-stub",
      "description": "Yellow perforated stub with a CSS barcode; downloads the CV.",
      "html": "<a class=\"ds-stub\" href=\"#\"><span class=\"ds-barcode\"></span><span>Download CV</span></a>",
      "css": ".ds-stub{display:flex;flex-direction:column;gap:16px;width:132px;padding:18px 16px;background:#ffc629;color:#141413;border-left:2px dashed #141413;text-decoration:none;font:800 20px/1.05 'Barlow Semi Condensed',Barlow,sans-serif;transition:background-color .2s}.ds-stub:hover{background:#ffd35c}.ds-stub:focus-visible{outline:3px solid #141413;outline-offset:-6px}.ds-barcode{min-height:120px;background:repeating-linear-gradient(90deg,#141413 0 3px,transparent 3px 5px,#141413 5px 6px,transparent 6px 9px,#141413 9px 13px,transparent 13px 15px)}"
    },
    {
      "name": "Check-in Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Concourse-filled field; focus adds a yellow halo.",
      "html": "<label class=\"ds-field\"><span>Name</span><input placeholder=\"Your name\"></label>",
      "css": ".ds-field{display:grid;gap:6px;font-family:Barlow,system-ui,sans-serif}.ds-field span{font-size:15px;font-weight:700;color:#141413}.ds-field input{min-height:50px;padding:12px 14px;border:2px solid #77726a;border-radius:2px;background:#ebe8e1;color:#141413;font:inherit;font-size:17px;transition:border-color .2s}.ds-field input:hover{border-color:#3b3934}.ds-field input:focus-visible{border-color:#141413;outline:0;box-shadow:0 0 0 4px #ffc629}"
    }
  ],
  "narrative": {
    "northStar": "Papan Keberangkatan",
    "overview": "The site is a daytime airport terminal. Warm concrete ground carries two materials that do all the talking: yellow wayfinding signs with black type for navigation and every primary action, and matte black split-flap boards for anything that is scheduled, measured or live. Projects are departures, sections are signed directions, the about page is a boarding pass and the contact form is a check-in desk. The visitor should be able to find the yellow action from anywhere, the way a traveller finds the exit sign.\n\nDensity is terminal-like: big, heavy condensed headings, square sign panels, catalogue grids that share their rules with no gutters, and short labelled rows. Nothing is a soft card. Depth comes from the boards and the boarding pass sitting on the concourse, not from floating surfaces.\n\nAt night the concourse goes dark but the signs and boards do not change: the header stays yellow, the boards stay black.",
    "keyCharacteristics": [
      "Sign yellow (#ffc629) with black type is the only action color; departure green is reserved for LIVE and NOW.",
      "Barlow throughout, Barlow Semi Condensed for display; tabular numerals on every number.",
      "Square corners (2px and 4px only); 2px black rules instead of shadows on most panels.",
      "Split-flap motion: characters spin and land left to right; the EN/ID toggle re-flaps every board.",
      "Every section title is a direction sign with a yellow arrow plate."
    ],
    "rules": [
      {
        "name": "The Wayfinding Rule",
        "body": "Yellow means \"go here\". It marks navigation and the primary action of a section, always with black type, and is never used as decoration or body-text color on light ground.",
        "section": "colors"
      },
      {
        "name": "The Green Lamp Rule",
        "body": "Departure green appears only for something that is live right now (LIVE, NOW, available) and only on black.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "`font-variant-numeric: tabular-nums` is set on body; every time, count, year and flight code aligns in columns.",
        "section": "typography"
      },
      {
        "name": "The Objects-Only Rule",
        "body": "A shadow means a physical object resting on the concourse (board, ticket, floating button). Signs, gates, counters and forms are flat with a 2px rule.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use sign yellow with black type for navigation and the one primary action per section.",
      "**Do** put anything scheduled, live or counted on a black board or chip, in tabular numerals.",
      "**Do** keep corners at 2px or 4px and separate panels with 2px ink rules.",
      "**Do** keep the header and boards identical in both themes; only the concourse changes at night.",
      "**Do** give every flap animation a static, reduced-motion fallback."
    ],
    "donts": [
      "**Don't** use departure green for anything that is not live right now, or on light ground.",
      "**Don't** set white type on sign yellow.",
      "**Don't** use soft rounded cards or floating shadows on signs, gates, counters or forms.",
      "**Don't** add a second accent hue; yellow, black and the green lamp are the whole signal vocabulary."
    ]
  }
}